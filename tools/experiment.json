{
  "_comment": "실행기(run_task.py)와 채점기(score_run.py)가 함께 읽는 경로·명령 설정. 상대 경로는 저장소 루트 기준. 에이전트·채점은 컨테이너 안(tools/README.md).",
  "task_dir": "tasks/seat-reservation",
  "skeleton_dir": "tasks/seat-reservation/skeleton",
  "steps": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"],
  "runs_dir": ".runs",
  "run_root": "/tmp/cx-run",
  "docker_bin": "docker",
  "resource_prefix": "cx-",
  "image": "cx-agent:2.1.326",
  "token_env_file": "~/.config/payment-lab/claude.env",
  "token_env_key": "CLAUDE_CODE_OAUTH_TOKEN",
  "refuse_when_running_prefixes": ["payment-"],
  "container": {
    "claude_bin": "claude",
    "hook_python": "/usr/bin/python3",
    "work": "/work",
    "home": "/home/agent",
    "hooks": "/cx/hooks",
    "hookdata": "/cx/hookdata",
    "cpus": "4",
    "memory": "6g",
    "pids_limit": 2048
  },
  "db": {
    "image": "postgres:16",
    "alias": "db",
    "name": "booking",
    "user": "booking",
    "password": "booking",
    "server_args": ["-c", "fsync=off", "-c", "max_connections=500"]
  },
  "allowed_tools": ["Bash", "Read", "Edit", "Write", "Grep", "Glob"],
  "permission_mode": "bypassPermissions",
  "compact_window": {"control": "1000000", "compact": "100000", "outbox": "100000"},
  "skeleton_commit": {
    "message": "skeleton",
    "name": "booking",
    "email": "booking@example.invalid",
    "date": "2026-01-01T00:00:00+00:00"
  },
  "audit_forbidden_patterns": [
    "{real_home}/project",
    "seat-reservation-lab",
    "backend-labs-commerce",
    "compaction-experiment",
    "agent-discipline",
    "{hooks}"
  ],
  "forbidden_tools": ["WebFetch", "WebSearch"],
  "hidden": {
    "dir": "tasks/seat-reservation/hidden",
    "pre_delete": ["src/test"],
    "overlay": [["src", "src"]],
    "main_build_command": ["./gradlew", "classes", "--no-daemon", "--console=plain"],
    "command": ["./gradlew", "test", "--tests", "hidden.contract.*", "--rerun", "--no-daemon", "--console=plain"],
    "junit_dir": "build/test-results/test",
    "items_file": "tasks/seat-reservation/hidden/items.json",
    "timeout_s": 3600,
    "unscorable_pattern": "^UNSCORABLE",
    "egress": true
  },
  "k1_exempt_paths": [
    "src/main/kotlin/com/example/booking/BookingApplication.kt",
    "src/test/kotlin/com/example/booking/TestDatabaseIsolation.kt",
    "src/test/kotlin/com/example/booking/BookingApplicationTests.kt"
  ],
  "k5_exempt_paths": [
    "src/test/kotlin/com/example/booking/BookingApplicationTests.kt"
  ],
  "hidden_test_path_prefix": "src/test/kotlin/hidden/",
  "k8_threshold": 0.5,
  "k8_min_chars": 20
}
